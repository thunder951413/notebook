{
  "name": "@notebook/desktop",
  "version": "0.1.0",
  "description": "AI-native, offline-first cross-platform notebook",
  "author": "Notebook contributors",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:native": "node scripts/build-macos-input-source-helper.mjs",
    "dev": "pnpm build:native && electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build:native && pnpm build && electron-builder --dir",
    "dist": "pnpm build:native && pnpm build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "app.notebook.next",
    "productName": "Notebook Next",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "build/notebook-input-source",
          "to": "bin/notebook-input-source"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thunder951413",
        "repo": "notebook",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
