# Only needed by the optional public HTTPS deployment.
NOTEBOOK_DOMAIN=notes.example.com

# Generate with: openssl rand -hex 32
NOTEBOOK_AI_API_TOKEN=replace-with-a-long-random-token

# Add the exact origins of hosted browser clients. Electron uses `null`.
NOTEBOOK_AI_ALLOWED_ORIGINS=null,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8057,http://localhost:8057,https://app.example.com

# Browser-only local SSH helper. Keep this false on a public server. The root
# ctl script enables it only on 127.0.0.1; Electron connects to SFTP directly.
NOTEBOOK_AI_ENABLE_LOCAL_SFTP_BRIDGE=false

# Optional LiteLLM provider variables, only needed for AI features.
# OPENAI_API_KEY=
